{
  "name": "my-shop-tier-list",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "validate:data": "node scripts/validate-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run validate:data && vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
